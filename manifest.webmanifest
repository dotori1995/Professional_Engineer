---
layout: null
permalink: /manifest.webmanifest
---
{
  "name": "{{ site.title }}",
  "short_name": "{{ site.short_name }}",
  "description": "{{ site.description }}",
  "lang": "ko",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d1117",
  "theme_color": "#1f6feb",
  "icons": [
    { "src": "{{ '/assets/icons/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/icons/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" },
    { "src": "{{ '/assets/icons/icon-512-maskable.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
